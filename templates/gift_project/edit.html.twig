{% extends 'base.html.twig' %}

{% block title %}Modifier le Projet{% endblock %}

{% block body %}
<section class="section">
    <div class="container">
        <div class="columns is-centered">
            <div class="column is-8-desktop is-10-tablet">
                <div class="box p-5">
                    <div class="is-flex is-align-items-center mb-5" style="gap: 0.85rem;">
                        <span class="kpi-icon is-primary">
                            {{ ux_icon('material-symbols:edit', {height: '1.5rem', width: '1.5rem'}) }}
                        </span>
                        <div>
                            <h1 class="title is-4 mb-1">Modifier le projet de cadeau</h1>
                            <p class="subtitle is-6 mb-0">{{ project.name }}</p>
                        </div>
                    </div>

                    {{ form_start(form) }}
                        <div class="field">
                            {{ form_label(form.name, 'Nom du projet', {'label_attr': {'class': 'label'}}) }}
                            <div class="control">
                                {{ form_widget(form.name, {'attr': {'class': 'input'}}) }}
                            </div>
                            {{ form_errors(form.name) }}
                        </div>

                        <div class="box has-background-light p-4 my-4">
                            <p class="heading mb-3">Destinataire du cadeau</p>
                            <div class="columns mb-0">
                                <div class="column is-one-third">
                                    <div class="field">
                                        {{ form_label(form.recipient, null, {'label_attr': {'class': 'label'}}) }}
                                        <div class="control">
                                            <div class="select is-fullwidth">
                                                {{ form_widget(form.recipient) }}
                                            </div>
                                        </div>
                                        <p class="help">{{ form.recipient.vars.help }}</p>
                                        {{ form_errors(form.recipient) }}
                                    </div>
                                </div>
                                <div class="column is-one-third">
                                    <div class="field">
                                        {{ form_label(form.managedRecipient, null, {'label_attr': {'class': 'label'}}) }}
                                        <div class="control">
                                            <div class="select is-fullwidth">
                                                {{ form_widget(form.managedRecipient) }}
                                            </div>
                                        </div>
                                        <p class="help">{{ form.managedRecipient.vars.help }}</p>
                                        {{ form_errors(form.managedRecipient) }}
                                    </div>
                                </div>
                                <div class="column is-one-third">
                                    <div class="field">
                                        {{ form_label(form.recipientName, null, {'label_attr': {'class': 'label'}}) }}
                                        <div class="control">
                                            {{ form_widget(form.recipientName, {'attr': {'class': 'input'}}) }}
                                        </div>
                                        <p class="help">{{ form.recipientName.vars.help }}</p>
                                        {{ form_errors(form.recipientName) }}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="field">
                            {{ form_label(form.description, 'Description', {'label_attr': {'class': 'label'}}) }}
                            <div class="control">
                                {{ form_widget(form.description, {'attr': {'class': 'textarea', 'rows': 3}}) }}
                            </div>
                            {{ form_errors(form.description) }}
                        </div>

                        <div class="field">
                            {{ form_label(form.targetDate, null, {'label_attr': {'class': 'label'}}) }}
                            <div class="control">
                                {{ form_widget(form.targetDate, {'attr': {'class': 'input'}}) }}
                            </div>
                            <p class="help">{{ form.targetDate.vars.help }}</p>
                            {{ form_errors(form.targetDate) }}
                        </div>

                        <div class="field is-grouped is-grouped-right mt-5">
                            <div class="control">
                                <a href="{{ path('app_project_show', {'id': project.id}) }}" class="button is-light">Annuler</a>
                            </div>
                            <div class="control">
                                <button class="button is-primary">Enregistrer les modifications</button>
                            </div>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
