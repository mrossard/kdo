<div class="box">
    <h3 class="title is-4">Bilan Financier</h3>

    <div class="columns">
        <div class="column is-6">
            <div class="card">
                <header class="card-header">
                    <p class="card-header-title">
                        <span class="icon mr-2">{{ ux_icon('material-symbols:account-balance-wallet') }}</span>
                        Récapitulatif des dépenses
                    </p>
                </header>
                <div class="card-content">
                    {% set can_edit_shares = (app.user == project.owner and project.deliveredAt is null) %}
                    {% if can_edit_shares %}
                        <form method="post" action="{{ path('app_project_update_shares', {'id': project.id}) }}"
                              hx-post="{{ path('app_project_update_shares', {'id': project.id}) }}"
                              hx-target="#project-content"
                              hx-swap="innerHTML">
                            <input type="hidden" name="_token" value="{{ csrf_token('update_shares_' ~ project.id) }}">
                    {% endif %}
                    <table class="table is-fullwidth is-striped is-vcentered">
                        <thead>
                            <tr>
                                <th>Participant</th>
                                <th class="has-text-right">Parts</th>
                                <th class="has-text-right">Part théorique</th>
                                <th class="has-text-right">Payé</th>
                                <th class="has-text-right">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in summary %}
                                <tr>
                                    <td>{{ item.user.displayName }}</td>
                                    <td class="has-text-right">
                                        {% if can_edit_shares %}
                                            <input class="input is-small has-text-right" type="number" step="0.5" min="0"
                                                   name="shares[{{ item.user.id }}]"
                                                   value="{{ item.share|default(1) }}"
                                                   style="width: 75px; display: inline-block;">
                                        {% else %}
                                            {{ item.share|default(1)|number_format(1, ',', ' ') }}
                                        {% endif %}
                                    </td>
                                    <td class="has-text-right">{{ item.target|default(average_cost)|number_format(2, ',', ' ') }} €</td>
                                    <td class="has-text-right">{{ item.paid|number_format(2, ',', ' ') }} €</td>
                                    <td class="has-text-right">
                                        {% if item.balance > 0 %}
                                            <span class="has-text-success">+{{ item.balance|number_format(2, ',', ' ') }} €</span>
                                        {% elseif item.balance < 0 %}
                                            <span class="has-text-danger">{{ item.balance|number_format(2, ',', ' ') }} €</span>
                                        {% else %}
                                            <span class="has-text-grey">-</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Total</th>
                                <th class="has-text-right">{{ total_shares|default(summary|length)|number_format(1, ',', ' ') }}</th>
                                <th class="has-text-right">{{ total_cost|number_format(2, ',', ' ') }} €</th>
                                <th class="has-text-right">{{ total_cost|number_format(2, ',', ' ') }} €</th>
                                <th></th>
                            </tr>
                            <tr>
                                <th colspan="2">Coût / part</th>
                                <th class="has-text-right">{{ cost_per_share|default(average_cost)|number_format(2, ',', ' ') }} €</th>
                                <th colspan="2"></th>
                            </tr>
                        </tfoot>
                    </table>
                    {% if can_edit_shares %}
                        <div class="has-text-right mt-2">
                            <button type="submit" class="button is-small is-link is-light">
                                <span class="icon is-small">{{ ux_icon('material-symbols:save') }}</span>
                                <span>Enregistrer les parts</span>
                            </button>
                        </div>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="column is-6">
            <div class="card">
                <header class="card-header">
                    <p class="card-header-title">
                        <span class="icon mr-2">{{ ux_icon('material-symbols:savings') }}</span>
                        Équilibrage (Qui doit à qui ?)
                    </p>
                </header>
                <div class="card-content">
                    {% if transfers is not empty %}
                        <div class="content">
                            <ul style="list-style: none; margin-left: 0;">
                                {% for transfer in transfers %}
                                    <li class="mb-3 box has-background-white-ter p-3">
                                        <div class="level is-mobile">
                                            <div class="level-left">
                                                <strong>{{ transfer.from.displayName }}</strong>
                                            </div>
                                            <div class="level-item has-text-centered">
                                                <div class="is-flex is-flex-direction-column is-align-items-center">
                                                    <span class="tag is-info is-light mb-1">{{ transfer.amount|number_format(2, ',', ' ') }} €</span>
                                                    <span class="icon has-text-grey-light">{{ ux_icon('material-symbols:arrow-right-alt') }}</span>
                                                </div>
                                            </div>
                                            <div class="level-right">
                                                <div class="is-flex is-flex-direction-column is-align-items-end">
                                                    <strong>{{ transfer.to.displayName }}</strong>
                                                    {% if transfer.to == app.user %}
                                                        <form method="post" action="{{ path('app_project_reimburse', {'id': project.id}) }}"
                                                              hx-post="{{ path('app_project_reimburse', {'id': project.id}) }}"
                                                              hx-confirm="Confirmez-vous avoir reçu {{ transfer.amount }} € de {{ transfer.from.displayName }} ?"
                                                              hx-target="body"
                                                              class="mt-1">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('reimburse_' ~ project.id) }}">
                                                            <input type="hidden" name="debtor_id" value="{{ transfer.from.id }}">
                                                            <input type="hidden" name="amount" value="{{ transfer.amount }}">
                                                            <button type="submit" class="button is-small is-success is-light" title="Confirmer la réception">
                                                                <span class="icon is-small">{{ ux_icon('material-symbols:check') }}</span>
                                                                <span>Reçu</span>
                                                            </button>
                                                        </form>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% else %}
                        <div class="notification is-success is-light">
                            Les comptes sont équilibrés !
                        </div>
                    {% endif %}

                    {% if reimbursements is not empty %}
                        <hr>
                        <h4 class="title is-6">Historique des remboursements</h4>
                        <div class="content is-small">
                            <ul>
                                {% for r in reimbursements %}
                                    <li>
                                        {{ r.createdAt|date('d/m') }} : 
                                        <strong>{{ r.fromUser.displayName }}</strong> a remboursé 
                                        <strong>{{ r.amount|number_format(2, ',', ' ') }} €</strong> à 
                                        <strong>{{ r.toUser.displayName }}</strong>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
