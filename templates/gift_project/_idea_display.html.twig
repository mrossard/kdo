{# templates/gift_project/_idea_display.html.twig #}
{#
Renders a single gift idea card.
Expected variables:
- idea: App\Entity\GiftIdea
- project: App\Entity\GiftProject (the parent project)
- user: App\Entity\User (the current authenticated user, for authorization checks)
#}

{% set card_class = '' %}
{% if idea.status == constant('App\\Entity\\GiftIdea::STATUS_SELECTED') %}
    {% set card_class = 'has-background-success-light is-selected' %}
{% elseif idea.status == constant('App\\Entity\\GiftIdea::STATUS_DISCARDED') %}
    {% set card_class = 'has-background-grey-lighter is-discarded' %}
{% endif %}

<div class="card idea-card h-100 {{ card_class }}" id="gift-idea-{{ idea.id }}">
    <div class="card-content p-4">
        {# Top bar: Tags, Price & Status #}
        <div class="is-flex is-justify-content-space-between is-align-items-center mb-3" style="gap: 0.5rem; flex-wrap: wrap;">
            <div class="tags mb-0">
                <span class="tag is-small {{ idea.priorityEnum.badgeClass }}">
                    <span class="icon is-small mr-1">{{ ux_icon(idea.priorityEnum.icon) }}</span>
                    <span>{{ idea.priorityEnum.label }}</span>
                </span>
                {% if idea.isCrowdfunded %}
                    <span class="tag is-warning is-light has-text-weight-semibold">
                        <span class="icon is-small mr-1">{{ ux_icon('material-symbols:savings') }}</span>
                        <span>Cagnotte</span>
                    </span>
                {% endif %}
                {% if idea.price %}
                    <span class="tag is-primary is-light has-text-weight-bold tabular-nums">
                        {{ idea.price|format_currency('EUR') }}
                    </span>
                {% else %}
                    <span class="tag is-light is-size-7">Prix libre</span>
                {% endif %}
            </div>

            <div>
                {% if idea.status == constant('App\\Entity\\GiftIdea::STATUS_SELECTED') %}
                    <span class="tag is-success is-medium">
                        <span class="icon is-small mr-1">{{ ux_icon('material-symbols:check-circle') }}</span>
                        <span>Validé</span>
                    </span>
                {% elseif idea.status == constant('App\\Entity\\GiftIdea::STATUS_DISCARDED') %}
                    <span class="tag is-danger is-light">
                        <span class="icon is-small mr-1">{{ ux_icon('material-symbols:block') }}</span>
                        <span>Mis de côté</span>
                    </span>
                {% else %}
                    <span class="tag is-info is-light">
                        <span class="icon is-small mr-1">{{ ux_icon('material-symbols:lightbulb') }}</span>
                        <span>Proposé</span>
                    </span>
                {% endif %}
            </div>
        </div>

        {# Main Media block: Adaptive Thumbnail + Title & Proposer #}
        <div class="is-flex is-align-items-flex-start mb-3" style="gap: 0.85rem;">
            {% if idea.imageUrl %}
                <div class="idea-thumb-box is-flex-shrink-0">
                    <img src="{{ idea.imageUrl }}" alt="{{ idea.name }}" loading="lazy">
                </div>
            {% else %}
                <div class="idea-thumb-box is-placeholder is-flex-shrink-0">
                    {{ ux_icon('material-symbols:redeem', {height: '1.75rem', width: '1.75rem'}) }}
                </div>
            {% endif %}

            <div class="is-flex-grow-1" style="min-width: 0;">
                <p class="title is-5 mb-1" style="word-break: break-word;">{{ idea.name }}</p>
                <div class="is-flex is-align-items-center mb-2" style="gap: 0.45rem;">
                    {{ include('_components/_avatar.html.twig', {name: idea.proposer.displayName, size: 'sm'}) }}
                    <span class="is-size-7 has-text-grey">Proposé par <strong class="has-text-grey-dark">{{ idea.proposer.displayName }}</strong></span>
                </div>
                {% if idea.url %}
                    <a href="{{ idea.url }}" target="_blank" rel="noopener noreferrer"
                       class="button is-small is-link is-light">
                        <span class="icon is-small">{{ ux_icon('material-symbols:open-in-new') }}</span>
                        <span>Voir le produit</span>
                    </a>
                {% endif %}
            </div>
        </div>

        {% if idea.description %}
            <div class="content is-size-7 has-text-grey mb-3 p-3 box has-background-light rounded">{{ idea.description|nl2br }}</div>
        {% endif %}

        {# Crowdfunding Section #}
        {% if idea.isCrowdfunded %}
            {% include 'gift_project/_crowdfund_section.html.twig' %}
        {% endif %}

        {# Purchased indicator & form #}
        {% if project.locked and idea.status == constant('App\\Entity\\GiftIdea::STATUS_SELECTED') %}
            <hr class="my-3">
            {% if idea.purchasedBy %}
                <div class="notification is-success is-light p-3 mb-2">
                    <div class="is-flex is-align-items-center mb-2" style="gap: 0.5rem;">
                        <span class="icon has-text-success">{{ ux_icon('material-symbols:shopping-bag') }}</span>
                        <div>
                            <strong>Acheté par {{ idea.purchasedBy.displayName }}</strong>
                            {% if idea.purchasePrice %}
                                <span class="tabular-nums">pour {{ idea.purchasePrice }} €</span>
                            {% endif %}
                        </div>
                    </div>
                    {% if project.deliveredAt is null and (app.user == idea.purchasedBy or app.user == project.owner) %}
                        <div class="is-flex is-flex-wrap-wrap is-align-items-center mt-2" style="gap: 0.5rem;">
                            <form method="post" action="{{ path('app_gift_idea_mark_purchased', {'id': idea.id}) }}"
                                  hx-post="{{ path('app_gift_idea_mark_purchased', {'id': idea.id}) }}"
                                  hx-target="body">
                                <input type="hidden" name="_token" value="{{ csrf_token('mark_purchased' ~ idea.id) }}">
                                <div class="field has-addons mb-0">
                                    <div class="control">
                                        <input class="input is-small tabular-nums" type="number" name="price" step="0.01"
                                               value="{{ idea.purchasePrice }}" placeholder="Prix réel (€)" required style="width: 110px;">
                                    </div>
                                    <div class="control">
                                        <button type="submit" class="button is-small is-link is-light">
                                            <span class="icon is-small">{{ ux_icon('material-symbols:edit') }}</span>
                                            <span>Modifier</span>
                                        </button>
                                    </div>
                                </div>
                            </form>
                            <form method="post" action="{{ path('app_gift_idea_unmark_purchased', {'id': idea.id}) }}"
                                  hx-post="{{ path('app_gift_idea_unmark_purchased', {'id': idea.id}) }}"
                                  hx-confirm="Voulez-vous annuler cet achat ?"
                                  hx-target="body">
                                <input type="hidden" name="_token" value="{{ csrf_token('unmark_purchased' ~ idea.id) }}">
                                <button type="submit" class="button is-small is-danger is-light">
                                    <span class="icon is-small">{{ ux_icon('material-symbols:undo') }}</span>
                                    <span>Annuler l'achat</span>
                                </button>
                            </form>
                        </div>
                    {% endif %}
                </div>
            {% elseif project.deliveredAt is null %}
                <form method="post" action="{{ path('app_gift_idea_mark_purchased', {'id': idea.id}) }}"
                      hx-post="{{ path('app_gift_idea_mark_purchased', {'id': idea.id}) }}"
                      hx-target="body">
                    <input type="hidden" name="_token" value="{{ csrf_token('mark_purchased' ~ idea.id) }}">
                    <div class="field has-addons">
                        <div class="control is-expanded">
                            <input class="input is-small tabular-nums" type="number" name="price" step="0.01"
                                   placeholder="Prix réel (€)" required>
                        </div>
                        <div class="control">
                            <button type="submit" class="button is-small is-success">
                                <span class="icon is-small">{{ ux_icon('material-symbols:shopping-cart') }}</span>
                                <span>J'ai acheté ça</span>
                            </button>
                        </div>
                    </div>
                </form>
            {% endif %}
        {% endif %}

        {# Proposer / Owner action buttons #}
        {% if (app.user == idea.proposer or app.user == project.owner) and not project.locked and project.deliveredAt is null %}
            <div class="buttons is-small mt-3 is-right">
                {% if not idea.isCrowdfunded %}
                    <form method="post"
                          action="{{ path('app_gift_idea_toggle_crowdfund', {'id': idea.id}) }}"
                          hx-post="{{ path('app_gift_idea_toggle_crowdfund', {'id': idea.id}) }}"
                          hx-target="#gift-idea-{{ idea.id }}"
                          hx-swap="outerHTML"
                          class="is-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_crowdfund' ~ idea.id) }}">
                        <button type="submit" class="button is-warning is-light" title="Lancer une cagnotte participative pour ce cadeau">
                            <span class="icon is-small">{{ ux_icon('material-symbols:savings') }}</span>
                            <span>Lancer cagnotte</span>
                        </button>
                    </form>
                {% elseif idea.isCrowdfunded and idea.contributions is empty %}
                    <form method="post"
                          action="{{ path('app_gift_idea_toggle_crowdfund', {'id': idea.id}) }}"
                          hx-post="{{ path('app_gift_idea_toggle_crowdfund', {'id': idea.id}) }}"
                          hx-target="#gift-idea-{{ idea.id }}"
                          hx-swap="outerHTML"
                          class="is-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_crowdfund' ~ idea.id) }}">
                        <button type="submit" class="button is-light has-text-grey" title="Désactiver la cagnotte">
                            <span class="icon is-small">{{ ux_icon('material-symbols:cancel') }}</span>
                            <span>Arrêter cagnotte</span>
                        </button>
                    </form>
                {% endif %}

                <button type="button"
                        class="button is-link is-light"
                        hx-get="{{ path('app_gift_idea_edit', {'id': idea.id}) }}"
                        hx-target="#gift-idea-{{ idea.id }}"
                        hx-swap="outerHTML">
                    <span class="icon is-small">{{ ux_icon('material-symbols:edit') }}</span>
                    <span>Modifier</span>
                </button>

                {% if app.user == project.owner %}
                    {% set status_sort = current_sort|default(app.request.query.get('sort', 'status')) %}
                    {% if idea.status == constant('App\\Entity\\GiftIdea::STATUS_PROPOSED') %}
                        <form method="post"
                              action="{{ path('app_gift_idea_status', {'id': idea.id, 'status': constant('App\\Entity\\GiftIdea::STATUS_SELECTED'), 'sort': status_sort}) }}"
                              hx-post="{{ path('app_gift_idea_status', {'id': idea.id, 'status': constant('App\\Entity\\GiftIdea::STATUS_SELECTED'), 'sort': status_sort}) }}"
                              hx-target="#project-content"
                              hx-swap="innerHTML">
                            <input type="hidden" name="_token" value="{{ csrf_token('status_idea' ~ idea.id) }}">
                            <button class="button is-success is-light">
                                <span class="icon is-small">{{ ux_icon('material-symbols:done') }}</span>
                                <span>Valider</span>
                            </button>
                        </form>
                    {% endif %}
                    {% if idea.status == constant('App\\Entity\\GiftIdea::STATUS_PROPOSED') %}
                        <form method="post"
                              action="{{ path('app_gift_idea_status', {'id': idea.id, 'status': constant('App\\Entity\\GiftIdea::STATUS_DISCARDED'), 'sort': status_sort}) }}"
                              hx-post="{{ path('app_gift_idea_status', {'id': idea.id, 'status': constant('App\\Entity\\GiftIdea::STATUS_DISCARDED'), 'sort': status_sort}) }}"
                              hx-target="#project-content"
                              hx-swap="innerHTML">
                            <input type="hidden" name="_token" value="{{ csrf_token('status_idea' ~ idea.id) }}">
                            <button class="button is-danger is-light">
                                <span class="icon is-small">{{ ux_icon('material-symbols:close') }}</span>
                                <span>Rejeter</span>
                            </button>
                        </form>
                    {% endif %}
                    {% if idea.status == constant('App\\Entity\\GiftIdea::STATUS_SELECTED') %}
                        <form method="post"
                              action="{{ path('app_gift_idea_status', {'id': idea.id, 'status': constant('App\\Entity\\GiftIdea::STATUS_PROPOSED'), 'sort': status_sort}) }}"
                              hx-post="{{ path('app_gift_idea_status', {'id': idea.id, 'status': constant('App\\Entity\\GiftIdea::STATUS_PROPOSED'), 'sort': status_sort}) }}"
                              hx-target="#project-content"
                              hx-swap="innerHTML">
                            <input type="hidden" name="_token" value="{{ csrf_token('status_idea' ~ idea.id) }}">
                            <button class="button is-danger is-light">
                                <span class="icon is-small">{{ ux_icon('material-symbols:refresh') }}</span>
                                <span>Invalider</span>
                            </button>
                        </form>
                    {% elseif idea.status == constant('App\\Entity\\GiftIdea::STATUS_DISCARDED') %}
                        <form method="post"
                              action="{{ path('app_gift_idea_status', {'id': idea.id, 'status': constant('App\\Entity\\GiftIdea::STATUS_PROPOSED'), 'sort': status_sort}) }}"
                              hx-post="{{ path('app_gift_idea_status', {'id': idea.id, 'status': constant('App\\Entity\\GiftIdea::STATUS_PROPOSED'), 'sort': status_sort}) }}"
                              hx-target="#project-content"
                              hx-swap="innerHTML">
                            <input type="hidden" name="_token" value="{{ csrf_token('status_idea' ~ idea.id) }}">
                            <button class="button is-success is-light">
                                <span class="icon is-small">{{ ux_icon('material-symbols:refresh') }}</span>
                                <span>Rétablir</span>
                            </button>
                        </form>
                    {% endif %}
                {% endif %}
            </div>
        {% endif %}

        {# Delete button #}
        {% if (app.user == idea.proposer or app.user == project.owner) and not project.locked and project.deliveredAt is null %}
            <div class="mt-3 has-text-right">
                <button type="button"
                        class="button is-danger is-small is-ghost"
                        hx-delete="{{ path('app_gift_idea_delete', {'id': idea.id, '_token': csrf_token('delete_idea' ~ idea.id)}) }}"
                        hx-confirm="Êtes-vous sûr de vouloir supprimer cette idée ?"
                        hx-target="closest .column"
                        hx-swap="outerHTML">
                    <span class="icon is-small">{{ ux_icon('material-symbols:delete') }}</span>
                    <span>Supprimer l'idée</span>
                </button>
            </div>
        {% endif %}
    </div>
</div>
