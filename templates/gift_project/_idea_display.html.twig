{# templates/gift_project/_idea_display.html.twig #}
{#
Renders a single gift idea card.
Expected variables:
- idea: App\Entity\GiftIdea
- project: App\Entity\GiftProject (the parent project)
- user: App\Entity\User (the current authenticated user, for authorization checks)
- comment_forms: Array of forms for adding comments (optional, if rendered directly)
#}

{% set card_class = '' %}
{% if idea.status == constant('App\\Entity\\GiftIdea::STATUS_SELECTED') %}
    {% set card_class = 'has-background-success-light' %}
{% elseif idea.status == constant('App\\Entity\\GiftIdea::STATUS_DISCARDED') %}
    {% set card_class = 'has-background-grey-lighter' %}
{% endif %}

<div class="card {{ card_class }}" id="gift-idea-{{ idea.id }}"> {# Add an ID for HTMX targeting #}
    <div class="card-content">
        <div class="level is-mobile mb-2">
            <div class="media-content">
                <p class="title is-4">{{ idea.name }}</p>
                <p class="subtitle is-6">{{ idea.price ? idea.price|format_currency('EUR') : 'Prix non défini' }}</p>
            </div>
            <div class="level-right">
                {% if idea.status == constant('App\\Entity\\GiftIdea::STATUS_SELECTED') %}
                    <span class="tag is-success is-medium">Validé</span>
                {% elseif idea.status == constant('App\\Entity\\GiftIdea::STATUS_DISCARDED') %}
                    <span class="tag is-danger is-light">Mis de côté</span>
                {% else %}
                    <span class="tag is-info is-light">Proposé</span>
                {% endif %}
            </div>
        </div>

        {% if idea.description %}
            <div class="content">{{ idea.description|nl2br }}</div>
        {% endif %}

        <div class="field is-grouped is-grouped-multiline">
            {% if idea.url %}
                <div class="control">
                    <a href="{{ idea.url }}" target="_blank" rel="noopener noreferrer"
                       class="button is-small is-link is-light">
                        <span class="icon is-small">{{ ux_icon('material-symbols:open-in-new') }}</span>
                        <span>Voir le produit</span>
                    </a>
                </div>
            {% endif %}

        </div>

        {% if project.locked and idea.status == constant('App\\Entity\\GiftIdea::STATUS_SELECTED') %}
            <hr class="is-small">
            {% if idea.purchasedBy %}
                <div class="notification is-success is-light p-3">
                    <span class="icon">{{ ux_icon('material-symbols:shopping-bag') }}</span>
                    <strong>Acheté par {{ idea.purchasedBy.displayName }}</strong>
                    {% if idea.purchasePrice %}
                        pour {{ idea.purchasePrice }} €
                    {% endif %}
                </div>
            {% else %}
                <form method="post" action="{{ path('app_gift_idea_mark_purchased', {'id': idea.id}) }}"
                      hx-post="{{ path('app_gift_idea_mark_purchased', {'id': idea.id}) }}"
                      hx-target="body">
                    <input type="hidden" name="_token" value="{{ csrf_token('mark_purchased' ~ idea.id) }}">
                    <div class="field has-addons">
                        <div class="control">
                            <input class="input is-small" type="number" name="price" step="0.01"
                                   placeholder="Prix réel (€)" required>
                        </div>
                        <div class="control">
                            <button type="submit" class="button is-small is-success">
                                <span class="icon is-small">{{ ux_icon('material-symbols:shopping-cart') }}</span>
                                <span>J'ai acheté ça</span>
                            </button>
                        </div>
                    </div>
                </form>
            {% endif %}
        {% endif %}


        {% if (app.user == idea.proposer or app.user == project.owner) and not project.locked %}
            <div class="buttons is-small mt-2 is-right">
                <button class="button is-link is-light"
                        hx-get="{{ path('app_gift_idea_edit', {'id': idea.id}) }}"
                        hx-target="#gift-idea-{{ idea.id }}"
                        hx-swap="outerHTML">
                    <span class="icon is-small">{{ ux_icon('material-symbols:edit') }}</span>
                    <span>Modifier</span>
                </button>

                {% if app.user == project.owner %}
                    {% if idea.status == constant('App\\Entity\\GiftIdea::STATUS_PROPOSED') %}
                        {# "Valider" button, shown if status is PROPOSED #}
                        <form method="post"
                              action="{{ path('app_gift_idea_status', {'id': idea.id, 'status': constant('App\\Entity\\GiftIdea::STATUS_SELECTED')}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('status_idea' ~ idea.id) }}">
                            <button class="button is-success is-light">
                                <span class="icon is-small">{{ ux_icon('material-symbols:done') }}</span>
                                <span>Valider</span>
                            </button>
                        </form>
                    {% endif %}
                    {% if idea.status == constant('App\\Entity\\GiftIdea::STATUS_PROPOSED') %}
                        {# "Rejeter" button, shown if status is PROPOSED #}
                        <form method="post"
                              action="{{ path('app_gift_idea_status', {'id': idea.id, 'status': constant('App\\Entity\\GiftIdea::STATUS_DISCARDED')}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('status_idea' ~ idea.id) }}">
                            <button class="button is-danger is-light">
                                <span class="icon is-small">{{ ux_icon('material-symbols:close') }}</span>
                                <span>Rejeter</span>
                            </button>
                        </form>
                    {% endif %}
                    {% if idea.status == constant('App\\Entity\\GiftIdea::STATUS_SELECTED') %}
                        {# "Invalider" button, shown if status is SELECTED #}
                        <form method="post"
                              action="{{ path('app_gift_idea_status', {'id': idea.id, 'status': constant('App\\Entity\\GiftIdea::STATUS_PROPOSED')}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('status_idea' ~ idea.id) }}">
                            <button class="button is-danger is-light"> {# Changed to is-danger #}
                                <span class="icon is-small">{{ ux_icon('material-symbols:refresh') }}</span>
                                <span>Invalider</span>
                            </button>
                        </form>
                    {% elseif idea.status == constant('App\\Entity\\GiftIdea::STATUS_DISCARDED') %}
                        {# "Rétablir" button, shown if status is DISCARDED #}
                        <form method="post"
                              action="{{ path('app_gift_idea_status', {'id': idea.id, 'status': constant('App\\Entity\\GiftIdea::STATUS_PROPOSED')}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('status_idea' ~ idea.id) }}">
                            <button class="button is-success is-light">
                                <span class="icon is-small">{{ ux_icon('material-symbols:refresh') }}</span>
                                <span>Rétablir</span>
                            </button>
                        </form>
                    {% endif %}
                {% endif %}
            </div>
        {% endif %}


        <hr class="is-small">
        <div class="comments-section">
            <h6 class="title is-6 mb-2">Commentaires</h6>
            <div id="comments-list-{{ idea.id }}">
                {% for comment in idea.comments %}
                    {% include 'gift_project/_comment.html.twig' %}
                {% else %}
                    <p class="is-size-7 has-text-grey-light is-italic mb-2">Aucun commentaire.</p>
                {% endfor %}
            </div>
            <div class="mt-2">
                {% if comment_forms[idea.id] is defined %}
                    {% set comment_form = comment_forms[idea.id] %}
                    {{ form_start(comment_form, {
                        'action': path('app_gift_idea_comment', {'id': idea.id}),
                        'attr': {
                            'hx-post': path('app_gift_idea_comment', {'id': idea.id}),
                            'hx-target': '#comments-list-' ~ idea.id,
                            'hx-swap': 'beforeend',
                            'hx-on::after-request': 'if(event.detail.successful) this.reset()'
                        }
                    }) }}
                    <div class="field has-addons">
                        <div class="control is-expanded">
                            {{ form_widget(comment_form.content, {'attr': {'placeholder': 'Votre commentaire...', 'class': 'textarea is-small', 'rows': '1'}}) }}
                        </div>
                        <div class="control">
                            <button type="submit" class="button is-small is-link is-light" style="height: auto;">
                                <span class="icon is-small">{{ ux_icon('material-symbols:send') }}</span>
                            </button>
                        </div>
                    </div>
                    {{ form_end(comment_form) }}
                {% endif %}
            </div>
        </div>

        {% if (app.user == idea.proposer or app.user == project.owner) and not project.locked %}
            <div class="mt-3 has-text-right">
                <button class="button is-danger is-small is-ghost"
                        hx-delete="{{ path('app_gift_idea_delete', {'id': idea.id, '_token': csrf_token('delete_idea' ~ idea.id)}) }}"
                        hx-confirm="Êtes-vous sûr de vouloir supprimer cette idée ?"
                        hx-target="closest .column"
                        hx-swap="outerHTML">
                    <span class="icon is-small">{{ ux_icon('material-symbols:delete') }}</span>
                    <span>Supprimer</span>
                </button>
            </div>
        {% endif %}
    </div>
</div>
