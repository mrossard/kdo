{% if project.hasWishlistRecipient %}
{% set recipientWishes = project.recipientWishes %}
{% set recipientName = project.recipientDisplayName %}
<div class="box">
    <div class="is-flex is-align-items-center mb-4" style="gap: 0.75rem;">
        {{ include('_components/_avatar.html.twig', {name: recipientName, size: 'md'}) }}
        <div>
            <h3 class="title is-4 mb-0">Liste de souhaits de {{ recipientName }}</h3>
            <p class="is-size-7 has-text-grey">Importez directement un souhait de {{ recipientName }} dans les idées du projet.</p>
        </div>
    </div>

    {% if recipientWishes is not empty %}
        <div class="columns is-multiline">
            {% for wish in recipientWishes %}
                <div class="column is-6">
                    <div class="card product-card h-100">
                        <div class="card-content">
                            <div class="is-flex is-align-items-flex-start" style="gap: 1rem;">
                                {% if wish.imageUrl %}
                                    <figure class="image is-64x64 is-flex-shrink-0">
                                        <img src="{{ wish.imageUrl }}" alt="{{ wish.name }}" class="wish-thumb" style="width: 64px; height: 64px;">
                                    </figure>
                                {% else %}
                                    <span class="kpi-icon is-light is-flex-shrink-0">
                                        {{ ux_icon('material-symbols:redeem') }}
                                    </span>
                                {% endif %}
                                <div class="is-flex-grow-1">
                                    <div class="is-flex is-justify-content-space-between is-align-items-flex-start mb-1" style="gap: 0.5rem;">
                                        <p class="title is-5 mb-0">{{ wish.name }}</p>
                                        {% if wish.price %}
                                            <span class="tag is-light has-text-weight-semibold tabular-nums">{{ wish.price }} €</span>
                                        {% endif %}
                                    </div>
                                    <span class="tag {{ wish.priorityEnum.badgeClass }} mb-2">
                                        <span class="icon is-small mr-1">{{ ux_icon(wish.priorityEnum.icon) }}</span>
                                        <span>{{ wish.priorityEnum.label }}</span>
                                    </span>
                                    {% if wish.description %}
                                        <p class="is-size-7 has-text-grey mb-2">{{ wish.description|nl2br }}</p>
                                    {% endif %}
                                    {% if wish.url %}
                                        <a href="{{ wish.url }}" target="_blank" rel="noopener noreferrer" class="button is-small is-link is-light mt-1">
                                            <span class="icon is-small">{{ ux_icon('material-symbols:open-in-new') }}</span>
                                            <span>Voir le produit</span>
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        <footer class="card-footer">
                            <div class="card-footer-item p-1">
                                {% if wish.id in copied_wish_ids|default([]) %}
                                    <button class="button is-light is-small is-fullwidth" disabled>
                                        <span class="icon is-small">{{ ux_icon('material-symbols:check') }}</span>
                                        <span>Déjà copié</span>
                                    </button>
                                {% elseif wish.reservedBy is not null and wish.reservedBy != app.user %}
                                    <button class="button is-warning is-light is-small is-fullwidth" disabled>
                                        <span class="icon is-small">{{ ux_icon('material-symbols:lock') }}</span>
                                        <span>Réservé par {{ wish.reservedBy.displayName }}</span>
                                    </button>
                                {% elseif not project.locked and project.deliveredAt is null %}
                                    <form class="w-100" method="post" action="{{ path('app_project_copy_wish', {'id': project.id, 'wish_id': wish.id}) }}"
                                          hx-post="{{ path('app_project_copy_wish', {'id': project.id, 'wish_id': wish.id}) }}"
                                          hx-target="body"
                                          hx-swap="outerHTML">
                                        <input type="hidden" name="_token" value="{{ csrf_token('copy_wish' ~ wish.id) }}">
                                        <button type="submit" class="button is-primary is-small is-light is-fullwidth">
                                            <span class="icon is-small">{{ ux_icon('material-symbols:content-copy') }}</span>
                                            <span>Copier en idée cadeau</span>
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </footer>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="notification is-info is-light">
            {{ recipientName }} n'a pas encore ajouté de souhaits à sa liste.
        </div>
    {% endif %}
</div>
{% endif %}
