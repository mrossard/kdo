{# templates/gift_project/_crowdfund_section.html.twig #}
{% set my_contrib = idea.contributionForUser(app.user) %}
{% set is_purchased = (idea.purchasedBy is not null) %}
{% set can_contribute = (not is_purchased and project.deliveredAt is null and (project.participants.contains(app.user) or project.owner == app.user)) %}

<div class="box is-light p-3 mt-3 mb-3" style="border: 1px solid var(--bulma-border-weak); border-radius: var(--bulma-radius-medium);">
    <div class="is-flex is-justify-content-space-between is-align-items-center mb-2" style="flex-wrap: wrap; gap: 0.5rem;">
        <div class="is-flex is-align-items-center" style="gap: 0.4rem;">
            <span class="kpi-icon is-sm is-primary">
                {{ ux_icon('material-symbols:savings', {height: '1.25rem', width: '1.25rem'}) }}
            </span>
            <span class="has-text-weight-bold is-size-7 is-uppercase has-text-grey">Cagnotte participative</span>
        </div>
        <div>
            {% if idea.price and idea.price > 0 %}
                <span class="tag {{ idea.progressPercentage >= 100 ? 'is-success' : 'is-info' }} is-light is-rounded has-text-weight-semibold tabular-nums">
                    {{ idea.totalContributed|number_format(2, ',', ' ') }} € / {{ idea.price|number_format(2, ',', ' ') }} €
                    ({{ idea.progressPercentage }}%)
                </span>
            {% else %}
                <span class="tag is-info is-light is-rounded has-text-weight-semibold tabular-nums">
                    Total : {{ idea.totalContributed|number_format(2, ',', ' ') }} €
                </span>
            {% endif %}
        </div>
    </div>

    {# Bulma Progress Bar #}
    {% if idea.price and idea.price > 0 %}
        <progress class="progress {{ idea.progressPercentage >= 100 ? 'is-success' : 'is-primary' }} is-small mb-2"
                  value="{{ idea.totalContributed }}"
                  max="{{ idea.price }}">
            {{ idea.progressPercentage }}%
        </progress>
    {% endif %}

    <div class="level is-mobile is-size-7 mb-2">
        <div class="level-left">
            <span class="has-text-grey">
                {{ idea.contributions|length }} participant{{ idea.contributions|length > 1 ? 's' : '' }}
            </span>
        </div>
        <div class="level-right">
            {% if idea.price and idea.price > 0 %}
                {% if idea.remainingAmount > 0 %}
                    <span class="has-text-danger has-text-weight-medium tabular-nums">
                        Reste {{ idea.remainingAmount|number_format(2, ',', ' ') }} €
                    </span>
                {% else %}
                    <span class="has-text-success has-text-weight-bold">
                        {{ ux_icon('material-symbols:check-circle') }} Objectif atteint !
                    </span>
                {% endif %}
            {% endif %}
        </div>
    </div>

    {# List of contributors #}
    {% if idea.contributions is not empty %}
        <div class="tags mb-3">
            {% for contrib in idea.contributions %}
                <span class="tag is-white is-rounded has-text-weight-medium tabular-nums is-flex is-align-items-center" style="gap: 0.35rem; border: 1px solid var(--bulma-border-weak);">
                    {{ include('_components/_avatar.html.twig', {name: contrib.user.displayName, size: 'xs'}) }}
                    <span>{{ contrib.user.displayName }} :</span>
                    <strong class="has-text-primary">{{ contrib.amount|number_format(2, ',', ' ') }} €</strong>
                </span>
            {% endfor %}
        </div>
    {% endif %}

    {# Contribution action / form #}
    {% if can_contribute %}
        <div class="pt-2" style="border-top: 1px dashed var(--bulma-border-weak);">
            {% if my_contrib %}
                <div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
                    <span class="is-size-7 has-text-grey">
                        Votre promesse : <strong class="has-text-success tabular-nums">{{ my_contrib.amount|number_format(2, ',', ' ') }} €</strong>
                    </span>
                    <form method="post" action="{{ path('app_gift_idea_contribute', {'id': idea.id}) }}"
                          hx-post="{{ path('app_gift_idea_contribute', {'id': idea.id}) }}"
                          hx-target="#gift-idea-{{ idea.id }}"
                          hx-swap="outerHTML">
                        <input type="hidden" name="_token" value="{{ csrf_token('contribute_idea' ~ idea.id) }}">
                        <input type="hidden" name="action" value="cancel">
                        <button type="submit" class="button is-ghost is-small p-0 has-text-danger" title="Retirer ma participation">
                            <span class="icon is-small">{{ ux_icon('material-symbols:close') }}</span>
                            <span>Annuler</span>
                        </button>
                    </form>
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_gift_idea_contribute', {'id': idea.id}) }}"
                  hx-post="{{ path('app_gift_idea_contribute', {'id': idea.id}) }}"
                  hx-target="#gift-idea-{{ idea.id }}"
                  hx-swap="outerHTML"
                  class="is-flex is-align-items-center" style="gap: 0.4rem;">
                <input type="hidden" name="_token" value="{{ csrf_token('contribute_idea' ~ idea.id) }}">
                <div class="field has-addons mb-0 is-flex-grow-1">
                    <div class="control is-expanded">
                        <input class="input is-small tabular-nums" type="number" step="0.5" min="1" name="amount"
                               value="{{ my_contrib ? my_contrib.amount : '' }}"
                               placeholder="Montant en €">
                    </div>
                    <div class="control">
                        <button type="submit" class="button is-small is-primary">
                            <span class="icon is-small">{{ ux_icon('material-symbols:add') }}</span>
                            <span>{{ my_contrib ? 'Modifier' : 'Participer' }}</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    {% elseif is_purchased %}
        <p class="is-size-7 has-text-grey is-italic mb-0 pt-2" style="border-top: 1px dashed var(--bulma-border-weak);">
            {{ ux_icon('material-symbols:lock') }} Cadeau acheté : la cagnotte est clôturée.
        </p>
    {% endif %}
</div>
