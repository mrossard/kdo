<div class="columns">
    <div class="column is-8">
        <div class="box">
            <div class="level is-mobile mb-4">
                <div class="level-left">
                    <div>
                        <div class="is-flex is-align-items-center is-flex-wrap-wrap mb-1" style="gap: 0.5rem;">
                            <h1 class="title is-3 mb-0">{{ project.name }}</h1>
                            {% if project.locked %}
                                <span class="tag is-warning is-light">
                                    <span class="icon is-small mr-1">{{ ux_icon('material-symbols:lock') }}</span>
                                    <span>Verrouillé</span>
                                </span>
                            {% endif %}
                            {% if project.deliveredAt %}
                                <span class="tag is-success is-light">
                                    <span class="icon is-small mr-1">{{ ux_icon('material-symbols:check-circle') }}</span>
                                    <span>Remis le {{ project.deliveredAt|date('d/m/Y') }}</span>
                                </span>
                            {% endif %}
                        </div>
                        <p class="subtitle is-6 mb-0">
                            Destinataire : <strong class="has-text-weight-semibold">{{ project.recipientDisplayName }}</strong>
                        </p>
                    </div>
                </div>
            </div>

            <div class="box has-background-light p-4 mb-4">
                <p class="{{ project.description ? '' : 'has-text-grey is-italic' }}">
                    {{ project.description|default('Aucune description.')|nl2br }}
                </p>
                {% if project.targetDate %}
                    <div class="is-flex is-align-items-center mt-3 pt-3" style="gap: 0.5rem; border-top: 1px solid var(--bulma-border-weak);">
                        <span class="icon is-small has-text-info">{{ ux_icon('material-symbols:event') }}</span>
                        <span class="is-size-7">Date cible : <strong class="tabular-nums">{{ project.targetDate|date('d/m/Y') }}</strong></span>
                        {% if project.targetDate < date() and project.deliveredAt is null %}
                            <span class="tag is-warning is-small ml-1">
                                <span class="icon is-small mr-1">{{ ux_icon('material-symbols:schedule') }}</span>
                                <span>Échéance dépassée</span>
                            </span>
                        {% endif %}
                    </div>
                {% endif %}
            </div>

            <div class="buttons is-right mt-4">
                {% if app.user == project.owner and project.deliveredAt is null %}
                    <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="button is-light" title="Modifier le projet">
                        <span class="icon">{{ ux_icon('material-symbols:edit') }}</span>
                        <span>Modifier</span>
                    </a>
                {% endif %}

                {% set has_purchased_ideas = project.giftIdeas|filter(idea => idea.purchasedBy is not null)|length > 0 %}

                {% if app.user in project.participants and not has_purchased_ideas and project.deliveredAt is null %}
                    <form method="post" action="{{ path('app_project_leave', {'id': project.id}) }}"
                          class="ml-2"
                          hx-post="{{ path('app_project_leave', {'id': project.id}) }}"
                          hx-confirm="Voulez-vous vraiment quitter ce projet ?"
                          hx-target="body">
                        <input type="hidden" name="_token" value="{{ csrf_token('leave_project' ~ project.id) }}">
                        <button type="submit" class="button is-danger is-light" title="Quitter le projet">
                            <span class="icon">{{ ux_icon('material-symbols:logout') }}</span>
                            <span>Quitter</span>
                        </button>
                    </form>
                {% endif %}

                {% if app.user == project.owner %}
                    <form method="post" action="{{ path('app_project_archive', {'id': project.id}) }}"
                          class="ml-2"
                          hx-post="{{ path('app_project_archive', {'id': project.id}) }}"
                          hx-confirm="Voulez-vous vraiment {{ project.archived ? 'désarchiver' : 'archiver' }} ce projet ?"
                          hx-target="body">
                        <input type="hidden" name="_token" value="{{ csrf_token('archive_project' ~ project.id) }}">
                        <button type="submit" class="button {{ project.archived ? 'is-primary is-light' : 'is-light' }}" title="{{ project.archived ? 'Désarchiver' : 'Archiver' }}">
                            <span class="icon">{{ ux_icon(project.archived ? 'material-symbols:unarchive' : 'material-symbols:archive') }}</span>
                            <span>{{ project.archived ? 'Désarchiver' : 'Archiver' }}</span>
                        </button>
                    </form>
                {% endif %}

                {% if app.user == project.owner and project.deliveredAt is null %}
                    <form method="post" action="{{ path('app_project_mark_delivered', {'id': project.id}) }}"
                          class="ml-2"
                          hx-post="{{ path('app_project_mark_delivered', {'id': project.id}) }}"
                          hx-confirm="Confirmer la remise du cadeau au destinataire ?"
                          hx-target="body">
                        <input type="hidden" name="_token" value="{{ csrf_token('mark_delivered' ~ project.id) }}">
                        <button type="submit" class="button is-success" title="Marquer comme remis">
                            <span class="icon">{{ ux_icon('material-symbols:redeem') }}</span>
                            <span>Marquer comme remis</span>
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="column is-4">
        <div class="box">
            <div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
                <h3 class="title is-5 mb-0">Participants</h3>
                <span class="tag is-rounded is-light">{{ project.participants|length + 1 }}</span>
            </div>

            <div class="participant-list">
                <div class="participant-row">
                    <div class="is-flex is-align-items-center" style="gap: 0.65rem;">
                        {{ include('_components/_avatar.html.twig', {name: project.owner.displayName, size: 'sm'}) }}
                        <div>
                            <p class="has-text-weight-semibold is-size-6">{{ project.owner.displayName }}</p>
                        </div>
                    </div>
                    <span class="tag is-primary is-light is-small">
                        <span class="icon is-small mr-1">{{ ux_icon('material-symbols:crown') }}</span>
                        <span>Organisateur</span>
                    </span>
                </div>

                {% for participant in project.participants %}
                    <div class="participant-row">
                        <div class="is-flex is-align-items-center" style="gap: 0.65rem;">
                            {{ include('_components/_avatar.html.twig', {name: participant.displayName, size: 'sm'}) }}
                            <span class="is-size-6">{{ participant.displayName }}</span>
                        </div>
                        {% if app.user == project.owner and project.deliveredAt is null %}
                            <form method="post" action="{{ path('app_project_remove_participant', {'id': project.id, 'participant_id': participant.id}) }}"
                                  hx-post="{{ path('app_project_remove_participant', {'id': project.id, 'participant_id': participant.id}) }}"
                                  hx-confirm="Voulez-vous vraiment retirer ce participant ?"
                                  hx-target="body">
                                <input type="hidden" name="_token" value="{{ csrf_token('remove_participant' ~ participant.id) }}">
                                <button type="submit" class="button is-small is-ghost has-text-danger" title="Retirer du projet">
                                    <span class="icon is-small">{{ ux_icon('material-symbols:close') }}</span>
                                </button>
                            </form>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>

            {% if project.deliveredAt is null %}
                <hr>
                <h4 class="title is-6 mb-2">Inviter un contact</h4>
                {{ form_start(add_participant_form) }}
                    <div class="field has-addons">
                        <div class="control is-expanded">
                            <div class="select is-fullwidth">
                                {{ form_widget(add_participant_form.participant) }}
                            </div>
                        </div>
                        <div class="control">
                            <button type="submit" class="button is-primary">
                                <span class="icon is-small">{{ ux_icon('material-symbols:person-add') }}</span>
                                <span>Inviter</span>
                            </button>
                        </div>
                    </div>
                    {{ form_errors(add_participant_form.participant) }}
                {{ form_end(add_participant_form) }}
            {% endif %}
        </div>
    </div>
</div>
