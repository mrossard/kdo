<div class="box">
    <div class="level">
        <div class="level-left">
            <h3 class="title is-4">Idées de cadeaux</h3>
        </div>
        <div class="level-right">
            <div class="field has-addons">
                <p class="control">
                    <a class="button is-small {{ current_sort == 'status' ? 'is-active is-primary' : '' }}"
                       hx-get="{{ path('app_project_show', {'id': project.id, 'tab': 'ideas', 'sort': 'status'}) }}"
                       hx-target="#project-content"
                       hx-push-url="true">
                        <span class="icon is-small">{{ ux_icon('material-symbols:sort') }}</span>
                        <span>Par statut</span>
                    </a>
                </p>
                <p class="control">
                    <a class="button is-small {{ current_sort == 'priority_desc' ? 'is-active is-primary' : '' }}"
                       hx-get="{{ path('app_project_show', {'id': project.id, 'tab': 'ideas', 'sort': 'priority_desc'}) }}"
                       hx-target="#project-content"
                       hx-push-url="true">
                        <span class="icon is-small">{{ ux_icon('material-symbols:favorite') }}</span>
                        <span>Priorité</span>
                    </a>
                </p>
                <p class="control">
                    <a class="button is-small {{ current_sort == 'price_asc' ? 'is-active is-primary' : '' }}"
                       hx-get="{{ path('app_project_show', {'id': project.id, 'tab': 'ideas', 'sort': 'price_asc'}) }}"
                       hx-target="#project-content"
                       hx-push-url="true">
                        Prix {{ ux_icon('material-symbols:arrow-upward') }}
                    </a>
                </p>
                <p class="control">
                    <a class="button is-small {{ current_sort == 'price_desc' ? 'is-active is-primary' : '' }}"
                       hx-get="{{ path('app_project_show', {'id': project.id, 'tab': 'ideas', 'sort': 'price_desc'}) }}"
                       hx-target="#project-content"
                       hx-push-url="true">
                        Prix {{ ux_icon('material-symbols:arrow-downward') }}
                    </a>
                </p>
            </div>
        </div>
    </div>

    {% set proposable_ideas = gift_ideas|filter(i => i.status != constant('App\\Entity\\GiftIdea::STATUS_DISCARDED')) %}
    {% set proposable_ideas = proposable_ideas|sort((a, b) => b.voteCount <=> a.voteCount) %}
    {% if not project.locked and project.deliveredAt is null and proposable_ideas is not empty %}
        {% set max_votes = proposable_ideas|first.voteCount %}
        {% set max_votes = max_votes > 0 ? max_votes : 1 %}
        <div class="box is-small has-background-light mb-4">
            <div class="level mb-0">
                <div class="level-left">
                    <span class="icon has-text-info">{{ ux_icon('material-symbols:how-to-vote') }}</span>
                    <strong class="ml-1">Sondage</strong>
                    <span class="has-text-grey ml-2 is-size-7">Cliquez pour voter</span>
                </div>
            </div>
            <div class="mt-2">
                {% for idea in proposable_ideas %}
                    {% set width = (idea.voteCount / max_votes * 100)|round %}
                    <div class="mb-1" style="cursor:pointer"
                         hx-post="{{ path('app_gift_idea_vote', {'id': idea.id}) }}"
                         hx-vals="{{ {'_token': csrf_token('vote_idea' ~ idea.id)}|json_encode }}"
                         hx-target="#project-content"
                         hx-swap="innerHTML">
                        <div class="level is-mobile mb-0">
                            <div class="level-left">
                                <span class="has-text-weight-semibold is-size-7">{{ idea.name }}</span>
                            </div>
                            <div class="level-right">
                                <span class="tag is-small {{ idea.hasVoteFromUser(app.user) ? 'is-success' : 'is-light' }}">
                                    <span class="icon is-small">{{ ux_icon('material-symbols:thumb-up') }}</span>
                                    <span>{{ idea.voteCount }}</span>
                                </span>
                            </div>
                        </div>
                        <div class="is-relative" style="height:6px;background:var(--bulma-scheme-main);border-radius:3px;">
                            <div class="{{ idea.hasVoteFromUser(app.user) ? 'has-background-success' : 'has-background-grey-light' }}" style="width:{{ width }}%;height:100%;border-radius:3px;transition:width .2s;"></div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {# Actions centrées en haut: Verrouiller / Déverrouiller #}
    {% if app.user == project.owner %}
        <div class="has-text-centered mb-4">
            {% if not project.locked %}
                {% set has_selected_idea = project.giftIdeas|filter(i => i.status == constant('App\\Entity\\GiftIdea::STATUS_SELECTED'))|length > 0 %}
                {% if has_selected_idea %}
                    <form method="post" action="{{ path('app_project_lock', {'id': project.id}) }}"
                          hx-post="{{ path('app_project_lock', {'id': project.id}) }}"
                          hx-confirm="Êtes-vous sûr de vouloir verrouiller le projet ? Plus aucune idée ne pourra être ajoutée ou modifiée."
                          hx-target="body">
                        <input type="hidden" name="_token" value="{{ csrf_token('lock_project' ~ project.id) }}">
                        <button type="submit" class="button is-warning" title="Verrouiller les idées">
                            <span class="icon">{{ ux_icon('material-symbols:lock') }}</span>
                            <span>Verrouiller</span>
                        </button>
                    </form>
                {% endif %}
            {% else %}
                {# Hide unlock button if the project has been delivered #}
                {% if project.deliveredAt is null %}
                    <form method="post" action="{{ path('app_project_unlock', {'id': project.id}) }}"
                          hx-post="{{ path('app_project_unlock', {'id': project.id}) }}"
                          hx-confirm="Voulez-vous vraiment déverrouiller le projet ?"
                          hx-target="body">
                        <input type="hidden" name="_token" value="{{ csrf_token('unlock_project' ~ project.id) }}">
                        <button type="submit" class="button is-info" title="Déverrouiller">
                            <span class="icon">{{ ux_icon('material-symbols:lock-open') }}</span>
                            <span>Déverrouiller</span>
                        </button>
                    </form>
                {% endif %}
            {% endif %}
        </div>
    {% endif %}
    {% if gift_ideas is not empty %}
        <div class="columns is-multiline">
            {% for idea in gift_ideas %}
                <div class="column is-6">
                    {% include 'gift_project/_idea_display.html.twig' with {'idea': idea, 'project': project, 'user': app.user, 'comment_forms': comment_forms} %}
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="notification is-info is-light">
            Aucune idée de cadeau proposée pour le moment.
        </div>
    {% endif %}

    <hr>

    {% if not project.locked and project.deliveredAt is null %}
        <div id="add-idea-form-container">
            {% include 'gift_project/_gift_idea_add_button.html.twig' %}
        </div>
    {% endif %}
</div>

