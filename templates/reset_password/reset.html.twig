{% extends 'base.html.twig' %}

{% block title %}Réinitialiser votre mot de passe{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">
                    <h1 class="title">Réinitialiser votre mot de passe</h1>

                    {{ form_start(resetForm) }}
                        <div class="field">
                            {{ form_label(resetForm.plainPassword.first, null, {'label_attr': {'class': 'label'}}) }}
                            <div class="control">
                                {{ form_widget(resetForm.plainPassword.first, {'attr': {'class': 'input'}}) }}
                            </div>
                            <div class="help is-danger">
                                {{ form_errors(resetForm.plainPassword.first) }}
                            </div>
                        </div>

                        <div class="field">
                            {{ form_label(resetForm.plainPassword.second, null, {'label_attr': {'class': 'label'}}) }}
                            <div class="control">
                                {{ form_widget(resetForm.plainPassword.second, {'attr': {'class': 'input'}}) }}
                            </div>
                            <div class="help is-danger">
                                {{ form_errors(resetForm.plainPassword.second) }}
                            </div>
                        </div>

                        <div class="field">
                            <div class="control">
                                <button class="button is-primary">Réinitialiser le mot de passe</button>
                            </div>
                        </div>
                    {{ form_end(resetForm) }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
