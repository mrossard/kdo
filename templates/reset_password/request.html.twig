{% extends 'base.html.twig' %}

{% block title %}Réinitialiser votre mot de passe{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">
                    <h1 class="title">Réinitialiser votre mot de passe</h1>

                    {% for flash_error in app.flashes('reset_password_error') %}
                        <div class="notification is-danger" role="alert">{{ flash_error }}</div>
                    {% endfor %}

                    {{ form_start(requestForm) }}
                        <div class="field">
                            {{ form_label(requestForm.email, null, {'label_attr': {'class': 'label'}}) }}
                            <div class="control">
                                {{ form_widget(requestForm.email, {'attr': {'class': 'input'}}) }}
                            </div>
                            <div class="help is-danger">
                                {{ form_errors(requestForm.email) }}
                            </div>
                        </div>

                        <div class="field">
                            <div class="control">
                                <button class="button is-primary">Envoyer l'e-mail de réinitialisation</button>
                            </div>
                        </div>
                    {{ form_end(requestForm) }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
