{% extends 'base.html.twig' %}

{% block title %}E-mail de réinitialisation envoyé{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">
                    <h1 class="title">E-mail de réinitialisation envoyé</h1>

                    <div class="content">
                        <p>
                            Si un compte existe pour cet e-mail, un e-mail a été envoyé contenant un lien pour réinitialiser votre mot de passe.
                            Ce lien expirera dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
                        </p>
                        <p>
                            Si vous ne recevez pas d'e-mail, veuillez vérifier votre dossier spam ou <a href="{{ path('app_forgot_password_request') }}">réessayer</a>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
