{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<section class="section">
    <div class="container">
        {% if app.user %}
            <div class="level mb-5">
                <div class="level-left">
                    <div>
                        <h1 class="title is-3 mb-1">Bonjour, {{ app.user.displayName }} 👋</h1>
                        <p class="subtitle is-6 mb-0">Voici un aperçu de vos listes et projets cadeaux.</p>
                    </div>
                </div>
                <div class="level-right">
                    <div class="buttons">
                        <a href="{{ path('app_wish_new') }}" class="button is-light">
                            <span class="icon">{{ ux_icon('material-symbols:add') }}</span>
                            <span>Nouveau souhait</span>
                        </a>
                        <a href="{{ path('app_project_new') }}" class="button is-primary">
                            <span class="icon">{{ ux_icon('material-symbols:redeem') }}</span>
                            <span>Nouveau projet</span>
                        </a>
                    </div>
                </div>
            </div>

            {% if not (app.user.uiPreferences.tour_completed ?? false) %}
                {{ include('tour/_banner.html.twig') }}
            {% endif %}

            <div class="columns is-multiline">
                <div class="column is-3-desktop is-6-tablet">
                    <a href="{{ path('app_wish_index') }}" class="box kpi-card h-100">
                        <div class="is-flex is-justify-content-space-between is-align-items-flex-start mb-4">
                            <span class="kpi-icon is-info">
                                {{ ux_icon('material-symbols:list', {height: '1.5rem', width: '1.5rem'}) }}
                            </span>
                            <span class="icon kpi-arrow">{{ ux_icon('material-symbols:arrow-forward') }}</span>
                        </div>
                        <div>
                            <p class="heading mb-1">Ma Liste</p>
                            <p class="title is-3 mb-1 tabular-nums">{{ wish_count }}</p>
                            <p class="is-size-7 has-text-grey">souhait{{ wish_count == 1 ? '' : 's' }} actif{{ wish_count == 1 ? '' : 's' }}</p>
                        </div>
                    </a>
                </div>

                <div class="column is-3-desktop is-6-tablet">
                    <a href="{{ path('app_project_index') }}" class="box kpi-card h-100">
                        <div class="is-flex is-justify-content-space-between is-align-items-flex-start mb-4">
                            <span class="kpi-icon is-primary">
                                {{ ux_icon('material-symbols:redeem', {height: '1.5rem', width: '1.5rem'}) }}
                            </span>
                            <span class="icon kpi-arrow">{{ ux_icon('material-symbols:arrow-forward') }}</span>
                        </div>
                        <div>
                            <p class="heading mb-1">Projets</p>
                            <p class="title is-3 mb-1 tabular-nums">{{ active_projects_count }}</p>
                            <p class="is-size-7 has-text-grey">projet{{ active_projects_count == 1 ? '' : 's' }} en cours</p>
                        </div>
                    </a>
                </div>

                <div class="column is-3-desktop is-6-tablet">
                    <a href="{{ path('app_financial_index') }}" class="box kpi-card h-100">
                        <div class="is-flex is-justify-content-space-between is-align-items-flex-start mb-4">
                            <span class="kpi-icon {{ global_balance >= 0 ? 'is-success' : 'is-danger' }}">
                                {{ ux_icon('material-symbols:savings', {height: '1.5rem', width: '1.5rem'}) }}
                            </span>
                            <span class="icon kpi-arrow">{{ ux_icon('material-symbols:arrow-forward') }}</span>
                        </div>
                        <div>
                            <p class="heading mb-1">Bilan Global</p>
                            <p class="title is-3 mb-1 tabular-nums {{ global_balance > 0 ? 'has-text-success' : (global_balance < 0 ? 'has-text-danger' : '') }}">
                                {{ global_balance >= 0 ? '+' : '' }}{{ global_balance|number_format(2, ',', ' ') }} €
                            </p>
                            <p class="is-size-7 has-text-grey">
                                {% if global_balance > 0 %}
                                    On vous doit de l'argent
                                {% elseif global_balance < 0 %}
                                    Vous devez de l'argent
                                {% else %}
                                    Comptes à l'équilibre
                                {% endif %}
                            </p>
                        </div>
                    </a>
                </div>

                <div class="column is-3-desktop is-6-tablet">
                    <a href="{{ path('app_contact_index') }}" class="box kpi-card h-100">
                        <div class="is-flex is-justify-content-space-between is-align-items-flex-start mb-4">
                            <span class="kpi-icon {{ pending_contacts_count > 0 ? 'is-warning' : 'is-link' }}">
                                {{ ux_icon('material-symbols:group', {height: '1.5rem', width: '1.5rem'}) }}
                            </span>
                            {% if pending_contacts_count > 0 %}
                                <span class="tag is-warning is-rounded is-small">{{ pending_contacts_count }} en attente</span>
                            {% else %}
                                <span class="icon kpi-arrow">{{ ux_icon('material-symbols:arrow-forward') }}</span>
                            {% endif %}
                        </div>
                        <div>
                            <p class="heading mb-1">Contacts</p>
                            <p class="title is-3 mb-1 tabular-nums">{{ contacts_count }}</p>
                            <p class="is-size-7 has-text-grey">contact{{ contacts_count == 1 ? '' : 's' }} mutuel{{ contacts_count == 1 ? '' : 's' }}</p>
                        </div>
                    </a>
                </div>
            </div>

            {% if recent_activities is not empty %}
                <div class="mt-6">
                    <div class="level is-mobile mb-3">
                        <div class="level-left">
                            <h2 class="title is-5 mb-0 is-flex is-align-items-center" style="gap: 0.5rem;">
                                <span class="icon has-text-primary">{{ ux_icon('material-symbols:history') }}</span>
                                <span>Activité récente</span>
                            </h2>
                        </div>
                    </div>
                    <div class="box p-0">
                        {% for activity in recent_activities %}
                            <div class="activity-row p-4 is-flex is-align-items-center is-justify-content-space-between">
                                <div class="is-flex is-align-items-center" style="gap: 0.85rem;">
                                    <span class="kpi-icon is-sm is-light is-flex-shrink-0">
                                        {{ ux_icon(activity.icon) }}
                                    </span>
                                    <div>
                                        <p class="has-text-weight-medium is-size-6">{{ activity.message }}</p>
                                        <p class="has-text-grey is-size-7">
                                            dans <a class="has-text-link has-text-weight-medium" href="{{ path('app_project_show', {'id': activity.project.id, 'tab': 'activite'}) }}">{{ activity.project.name }}</a>
                                        </p>
                                    </div>
                                </div>
                                <span class="tag is-light is-size-7 tabular-nums">{{ activity.createdAt|date('d/m H:i') }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

        {% else %}
            <div class="hero is-medium is-primary is-bold rounded">
                <div class="hero-body has-text-centered py-6">
                    <span class="tag is-light is-rounded mb-4">Cadeaux & Cagnottes entre proches</span>
                    <h1 class="title is-1 mb-3">
                        Bienvenue sur KDO
                    </h1>
                    <h2 class="subtitle is-5 mb-5" style="max-width: 540px; margin-left: auto; margin-right: auto; color: rgba(255,255,255,0.88);">
                        Partagez vos listes de souhaits et organisez vos cadeaux communs sans jamais gâcher la surprise.
                    </h2>
                    <div class="buttons is-centered mt-5">
                        <a href="{{ path('app_login') }}" class="button is-light is-medium">
                            <span class="icon">{{ ux_icon('material-symbols:login') }}</span>
                            <span>Connexion</span>
                        </a>
                        <a href="{{ path('app_register') }}" class="button is-dark is-medium">
                            <span class="icon">{{ ux_icon('material-symbols:person-add') }}</span>
                            <span>Inscription</span>
                        </a>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
