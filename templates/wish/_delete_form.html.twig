<form method="post" action="{{ path('app_wish_delete', {'id': wish.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce souhait ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ wish.id) }}">
    <button class="button is-danger is-light">Supprimer</button>
</form>
