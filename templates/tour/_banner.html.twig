<div id="kdo-tour-banner" class="box mb-5 p-4 is-flex-tablet is-justify-content-space-between is-align-items-center" style="background: var(--bulma-scheme-main-bis); border-left: 4px solid var(--bulma-primary); border-top: 1px solid var(--bulma-border-weak); border-right: 1px solid var(--bulma-border-weak); border-bottom: 1px solid var(--bulma-border-weak);">
    <div class="is-flex is-align-items-center mb-3 mb-0-tablet" style="gap: 1rem;">
        <span class="kpi-icon is-primary is-flex-shrink-0">
            {{ ux_icon('material-symbols:redeem', {height: '1.5rem', width: '1.5rem'}) }}
        </span>
        <div>
            <h2 class="title is-6 mb-1">Nouveau sur KDO ? Découvrez l'application !</h2>
            <p class="is-size-7 has-text-grey mb-0">
                Faites le tour en 2 minutes : listes de souhaits, organisation de cadeaux secrets, cagnottes et équilibrage des comptes.
            </p>
        </div>
    </div>
    <div class="buttons are-small is-flex-shrink-0 mb-0">
        <button type="button"
                class="button is-primary"
                data-tour-start>
            <span class="icon">{{ ux_icon('material-symbols:redeem') }}</span>
            <span>Démarrer la visite</span>
        </button>
        <button type="button"
                class="button is-light"
                hx-post="{{ path('app_tour_dismiss') }}"
                hx-target="#kdo-tour-banner"
                hx-swap="outerHTML">
            <span>Ne plus afficher</span>
        </button>
    </div>
</div>
