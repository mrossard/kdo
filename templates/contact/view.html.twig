{% extends 'base.html.twig' %}

{% set is_managed = managed_person is defined and managed_person is not null %}
{% set display_owner_name = is_managed ? managed_person.displayName : owner.displayName %}

{% block title %}Liste de {{ display_owner_name }}{% endblock %}

{% block body %}
<section class="section">
    <div class="container">
        <div class="level mb-5">
            <div class="level-left">
                <div class="is-flex is-align-items-center" style="gap: 1rem;">
                    {{ include('_components/_avatar.html.twig', {name: display_owner_name, size: 'lg'}) }}
                    <div>
                        <h1 class="title is-3 mb-1">Liste de souhaits de {{ display_owner_name }}</h1>
                        {% if is_managed %}
                            <p class="subtitle is-6 mb-0">Liste gérée par {{ managed_person.allManagers|map(m => m.displayName)|join(', ') }} · Réservez un cadeau en solo ou lancez un projet commun.</p>
                        {% else %}
                            <p class="subtitle is-6 mb-0">Réservez un cadeau en solo ou lancez un projet commun ({{ owner.displayName }} ne verra rien !).</p>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="level-right">
                <a href="{{ path('app_contact_index') }}" class="button is-light">
                    <span class="icon">{{ ux_icon('material-symbols:arrow-back') }}</span>
                    <span>Retour aux contacts</span>
                </a>
            </div>
        </div>

        {% if managed_persons|default([]) is not empty %}
            <div class="tabs is-boxed mb-5">
                <ul>
                    <li class="{{ not is_managed ? 'is-active' : '' }}">
                        <a href="{{ path('app_contact_view', {'id': owner.id}) }}">
                            <span class="icon is-small">{{ ux_icon('material-symbols:person') }}</span>
                            <span>{{ owner.displayName }}</span>
                        </a>
                    </li>
                    {% for person in managed_persons %}
                        <li class="{{ (is_managed and managed_person.id == person.id) ? 'is-active' : '' }}">
                            <a href="{{ path('app_contact_managed_view', {'id': person.id}) }}">
                                <span class="icon is-small">{{ ux_icon('material-symbols:face') }}</span>
                                <span>{{ person.displayName }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="columns is-multiline">
        {% for wish in wishes %}
            {% set activeProject = wish.activeProject %}
            <div class="column is-one-third-desktop is-half-tablet">
                <div class="card product-card h-100">
                    <div class="product-card-media">
                        {% if wish.imageUrl %}
                            <img src="{{ wish.imageUrl }}" alt="{{ wish.name }}" loading="lazy">
                        {% else %}
                            <div class="product-card-placeholder">
                                {{ ux_icon('material-symbols:redeem', {height: '2.75rem', width: '2.75rem'}) }}
                            </div>
                        {% endif %}
                        {% if wish.price %}
                            <span class="product-price-badge tabular-nums">{{ wish.price }} €</span>
                        {% endif %}
                    </div>

                    <div class="card-content">
                        <div class="tags mb-2">
                            <span class="tag {{ wish.priorityEnum.badgeClass }}">
                                <span class="icon is-small mr-1">{{ ux_icon(wish.priorityEnum.icon) }}</span>
                                <span>{{ wish.priorityEnum.label }}</span>
                            </span>
                            {% if activeProject is not null %}
                                <span class="tag is-info is-light">
                                    <span class="icon is-small mr-1">{{ ux_icon('material-symbols:group') }}</span>
                                    <span>Dans un projet ({{ activeProject.owner.displayName }})</span>
                                </span>
                            {% elseif wish.reservedBy is not null %}
                                {% if wish.reservedBy == app.user %}
                                    <span class="tag is-success is-light">
                                        <span class="icon is-small mr-1">{{ ux_icon('material-symbols:bookmark-check') }}</span>
                                        <span>Réservé par vous</span>
                                    </span>
                                {% else %}
                                    <span class="tag is-warning is-light">
                                        <span class="icon is-small mr-1">{{ ux_icon('material-symbols:lock') }}</span>
                                        <span>Réservé par {{ wish.reservedBy.displayName }}</span>
                                    </span>
                                {% endif %}
                            {% endif %}
                        </div>

                        <p class="title is-5 mb-2">{{ wish.name }}</p>

                        {% if wish.description %}
                            <p class="is-size-6 has-text-grey mb-3">{{ wish.description|nl2br }}</p>
                        {% endif %}

                        {% if wish.url %}
                            <a href="{{ wish.url }}" target="_blank" rel="noopener noreferrer" class="button is-small is-link is-light">
                                <span class="icon is-small">{{ ux_icon('material-symbols:open-in-new') }}</span>
                                <span>Voir le produit</span>
                            </a>
                        {% endif %}
                    </div>

                    <footer class="card-footer">
                        {% if activeProject is not null %}
                            {% if app.user == activeProject.owner or app.user in activeProject.participants %}
                                <a href="{{ path('app_project_show', {'id': activeProject.id}) }}" class="card-footer-item button is-link is-light is-small">
                                    <span class="icon is-small mr-1">{{ ux_icon('material-symbols:visibility') }}</span>
                                    <span>Voir le projet</span>
                                </a>
                            {% else %}
                                <span class="card-footer-item has-text-grey is-size-7">
                                    <span class="icon is-small mr-1">{{ ux_icon('material-symbols:lock') }}</span>
                                    <span>Pris dans un projet ({{ activeProject.owner.displayName }})</span>
                                </span>
                            {% endif %}
                        {% elseif wish.reservedBy is not null %}
                            {% if wish.reservedBy == app.user %}
                                <form class="card-footer-item p-1" method="post" action="{{ path('app_contact_wish_toggle_reserve', {'id': wish.id}) }}"
                                      hx-post="{{ path('app_contact_wish_toggle_reserve', {'id': wish.id}) }}"
                                      hx-target="body">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_reserve_wish' ~ wish.id) }}">
                                    <button type="submit" class="button is-warning is-light is-small is-fullwidth">
                                        <span class="icon is-small">{{ ux_icon('material-symbols:bookmark-remove') }}</span>
                                        <span>Libérer</span>
                                    </button>
                                </form>
                                {% set create_project_url = is_managed
                                    ? path('app_project_create_from_managed_wish', {'managedPersonId': managed_person.id, 'wishId': wish.id})
                                    : path('app_project_create_from_wish', {'contactId': owner.id, 'wishId': wish.id})
                                %}
                                <form class="card-footer-item p-1" method="post" action="{{ create_project_url }}"
                                      hx-post="{{ create_project_url }}"
                                      hx-confirm="Voulez-vous convertir votre réservation en projet cadeau groupé ?"
                                      hx-target="body">
                                    <input type="hidden" name="_token" value="{{ csrf_token('create_project_from_wish' ~ wish.id) }}">
                                    <button type="submit" class="button is-primary is-small is-fullwidth">
                                        <span class="icon is-small">{{ ux_icon('material-symbols:group-add') }}</span>
                                        <span>Projet groupé</span>
                                    </button>
                                </form>
                            {% else %}
                                <span class="card-footer-item has-text-grey is-size-7">
                                    <span class="icon is-small mr-1">{{ ux_icon('material-symbols:lock') }}</span>
                                    <span>Réservé par {{ wish.reservedBy.displayName }}</span>
                                </span>
                            {% endif %}
                        {% else %}
                            <form class="card-footer-item p-1" method="post" action="{{ path('app_contact_wish_toggle_reserve', {'id': wish.id}) }}"
                                  hx-post="{{ path('app_contact_wish_toggle_reserve', {'id': wish.id}) }}"
                                  hx-target="body">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle_reserve_wish' ~ wish.id) }}">
                                <button type="submit" class="button is-success is-light is-small is-fullwidth">
                                    <span class="icon is-small">{{ ux_icon('material-symbols:bookmark-add') }}</span>
                                    <span>Réserver (solo)</span>
                                </button>
                            </form>
                            {% set create_project_url = is_managed
                                ? path('app_project_create_from_managed_wish', {'managedPersonId': managed_person.id, 'wishId': wish.id})
                                : path('app_project_create_from_wish', {'contactId': owner.id, 'wishId': wish.id})
                            %}
                            <form class="card-footer-item p-1" method="post" action="{{ create_project_url }}"
                                  hx-post="{{ create_project_url }}"
                                  hx-confirm="Voulez-vous créer un projet cadeau avec ce souhait ?"
                                  hx-target="body">
                                <input type="hidden" name="_token" value="{{ csrf_token('create_project_from_wish' ~ wish.id) }}">
                                <button type="submit" class="button is-primary is-small is-fullwidth">
                                    <span class="icon is-small">{{ ux_icon('material-symbols:redeem') }}</span>
                                    <span>Projet groupé</span>
                                </button>
                            </form>
                        {% endif %}
                    </footer>
                </div>
            </div>
        {% else %}
            <div class="column is-full">
                <div class="box empty-state has-text-centered py-6">
                    <span class="kpi-icon is-info mx-auto mb-3">
                        {{ ux_icon('material-symbols:redeem', {height: '1.75rem', width: '1.75rem'}) }}
                    </span>
                    <p class="title is-5 mb-1">Liste vide</p>
                    <p class="subtitle is-6 mb-0">Cette liste est vide pour le moment.</p>
                </div>
            </div>
        {% endfor %}
        </div>
    </div>
</section>
{% endblock %}
