{% extends 'base.html.twig' %}

{% block title %}Mes Contacts{% endblock %}

{% block body %}
<section class="section">
    <div class="container">
        <div class="level mb-5">
            <div class="level-left">
                <div>
                    <h1 class="title is-3 mb-1">Mes Contacts</h1>
                    <p class="subtitle is-6 mb-0">Partagez mutuellement vos listes de souhaits et consultez vos soldes.</p>
                </div>
            </div>
        </div>

        <div class="columns is-multiline">
            {# Contacts mutuels #}
            <div class="column is-7-desktop is-12-tablet">
                <div class="box h-100" data-tour="contact-list">
                    <div class="is-flex is-justify-content-space-between is-align-items-center mb-4">
                        <h2 class="title is-5 mb-0">Mes contacts mutuels</h2>
                        <span class="tag is-rounded is-light">{{ my_contacts|length }}</span>
                    </div>
                    <div class="table-container">
                    <table class="table is-fullwidth">
                        <thead>
                            <tr>
                                <th>Contact</th>
                                <th>Balance</th>
                                <th class="has-text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for contact in my_contacts %}
                            <tr>
                                <td>
                                    <div class="is-flex is-align-items-center" style="gap: 0.65rem;">
                                        {{ include('_components/_avatar.html.twig', {name: contact.displayName, size: 'sm'}) }}
                                        <div>
                                            <span class="has-text-weight-medium">{{ contact.displayName }}</span>
                                            {% set contact_managed = managed_persons_by_manager[contact.id]|default([]) %}
                                            {% if contact_managed is not empty %}
                                                <div class="tags mt-1 mb-0">
                                                    {% for person in contact_managed %}
                                                        {% set person_wish_count = managed_wish_counts[person.id]|default(0) %}
                                                        <a href="{{ path('app_contact_managed_view', {'id': person.id}) }}"
                                                           class="tag {{ person_wish_count > 0 ? 'is-info is-light' : 'is-light has-text-grey' }}"
                                                           title="{{ person_wish_count > 0 ? person_wish_count ~ ' souhait(s) dans la liste de ' ~ person.displayName : 'Liste vide' }}">
                                                            <span class="icon is-small mr-1">{{ ux_icon('material-symbols:face') }}</span>
                                                            <span>{{ person.displayName }}</span>
                                                            <span class="ml-1 has-text-weight-semibold tabular-nums">({{ person_wish_count }})</span>
                                                        </a>
                                                    {% endfor %}
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </td>
                                <td class="tabular-nums">
                                    {% set balance = contact_balances[contact.id] %}
                                    {% if balance > 0 %}
                                        <span class="tag is-success is-light">+{{ balance|format_currency('EUR', locale='fr') }}</span>
                                    {% elseif balance < 0 %}
                                        <span class="tag is-danger is-light">{{ balance|format_currency('EUR', locale='fr') }}</span>
                                    {% else %}
                                        <span class="tag is-light">0,00 €</span>
                                    {% endif %}
                                </td>
                                <td class="has-text-right">
                                    <div class="buttons are-small is-right">
                                        {% if contact_balances[contact.id] < 0 %}
                                            <form method="post"
                                                  action="{{ path('app_contact_settle_debt', {'id': contact.id}) }}"
                                                  hx-post="{{ path('app_contact_settle_debt', {'id': contact.id}) }}"
                                                  hx-confirm="Confirmer que {{ contact.displayName }} vous a remboursé ?"
                                                  hx-target="body">
                                                <input type="hidden" name="_token" value="{{ csrf_token('settle_debt' ~ contact.id) }}">
                                                <button class="button is-success is-light" title="Signaler dette payée">
                                                    <span class="icon">{{ ux_icon('material-symbols:paid') }}</span>
                                                </button>
                                            </form>
                                        {% endif %}
                                        {% set wish_count = contact_wish_counts[contact.id]|default(0) %}
                                        <a href="{{ path('app_contact_view', {'id': contact.id}) }}"
                                           class="button {{ wish_count > 0 ? 'is-info is-light' : 'is-light has-text-grey' }}"
                                           title="{{ wish_count > 0 ? wish_count ~ ' souhait(s) dans la liste de ' ~ contact.displayName : 'Liste de souhaits vide' }}">
                                            <span class="icon">{{ ux_icon('material-symbols:list') }}</span>
                                            <span>Sa liste</span>
                                            <span class="tag is-rounded {{ wish_count > 0 ? 'is-info' : 'is-white has-text-grey' }} ml-2 tabular-nums">{{ wish_count }}</span>
                                        </a>
                                        <form method="post"
                                              action="{{ path('app_contact_remove', {'id': contact.id}) }}"
                                              hx-post="{{ path('app_contact_remove', {'id': contact.id}) }}"
                                              hx-confirm="Êtes-vous sûr de vouloir supprimer ce contact ?"
                                              hx-target="body">
                                            <input type="hidden" name="_token" value="{{ csrf_token('remove_contact' ~ contact.id) }}">
                                            <button class="button is-small is-danger is-light" title="Supprimer ce contact">
                                                <span class="icon">{{ ux_icon('material-symbols:delete') }}</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="has-text-grey is-italic has-text-centered py-5">Vous n'avez pas encore de contacts mutuels.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>

            {# Demandes reçues & envoyées #}
            <div class="column is-5-desktop is-12-tablet">
                <div class="box mb-5" data-tour="contact-invite">
                    <h2 class="title is-5 mb-3">Ajouter ou inviter un proche</h2>

                    <div class="field">
                        <label class="label is-small" for="contact-search-input">Rechercher un membre déjà inscrit</label>
                        <div class="control has-icons-left">
                            <input id="contact-search-input"
                                   type="search"
                                   name="q"
                                   class="input"
                                   placeholder="Prénom, nom ou e-mail..."
                                   autocomplete="off"
                                   hx-get="{{ path('app_contact_search') }}"
                                   hx-trigger="input changed delay:250ms, search"
                                   hx-target="#contact-search-results">
                            <span class="icon is-small is-left">{{ ux_icon('material-symbols:search') }}</span>
                        </div>
                    </div>
                    <div id="contact-search-results" class="mb-4"></div>

                    <hr class="my-4">

                    <label class="label is-small" for="{{ add_contact_form.email.vars.id }}">Ou inviter par e-mail (pas encore inscrit)</label>
                    {{ form_start(add_contact_form) }}
                        <div class="field has-addons">
                            <div class="control is-expanded">
                                {{ form_widget(add_contact_form.email) }}
                            </div>
                            <div class="control">
                                <button type="submit" class="button is-primary">
                                    <span class="icon">{{ ux_icon('material-symbols:send') }}</span>
                                    <span>Envoyer</span>
                                </button>
                            </div>
                        </div>
                        {{ form_errors(add_contact_form.email) }}
                    {{ form_end(add_contact_form) }}

                    <h3 class="heading mt-5 mb-2">Demandes envoyées</h3>
                    <div class="table-container">
                    <table class="table is-fullwidth">
                        <thead>
                            <tr>
                                <th>Destinataire</th>
                                <th class="has-text-right">Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for request in sent_requests %}
                            <tr>
                                <td>
                                    <div class="is-flex is-align-items-center" style="gap: 0.5rem;">
                                        {{ include('_components/_avatar.html.twig', {name: request.recipientDisplayName, size: 'sm'}) }}
                                        <span>{{ request.recipientDisplayName }}</span>
                                    </div>
                                </td>
                                <td class="has-text-right">
                                    {% if request.recipient is null %}
                                        <span class="tag is-info is-light">Invitation envoyée</span>
                                    {% else %}
                                        <span class="tag is-warning is-light">En attente</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="2" class="has-text-grey is-italic">Aucune demande envoyée.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    </div>
                </div>

                <div class="box">
                    <div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
                        <h2 class="title is-5 mb-0">Demandes reçues</h2>
                        {% if received_requests is not empty %}
                            <span class="tag is-warning is-rounded">{{ received_requests|length }}</span>
                        {% endif %}
                    </div>
                    <div class="table-container">
                    <table class="table is-fullwidth">
                        <thead>
                            <tr>
                                <th>Expéditeur</th>
                                <th class="has-text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for request in received_requests %}
                            <tr>
                                <td>
                                    <div class="is-flex is-align-items-center" style="gap: 0.5rem;">
                                        {{ include('_components/_avatar.html.twig', {name: request.sender.displayName, size: 'sm'}) }}
                                        <span class="has-text-weight-medium">{{ request.sender.displayName }}</span>
                                    </div>
                                </td>
                                <td class="has-text-right">
                                    <div class="buttons are-small is-right">
                                        <form method="post"
                                              action="{{ path('app_contact_request_accept', {'id': request.id}) }}"
                                              hx-post="{{ path('app_contact_request_accept', {'id': request.id}) }}"
                                              hx-confirm="Accepter la demande de {{ request.sender.displayName }} ?"
                                              hx-target="body">
                                            <input type="hidden" name="_token" value="{{ csrf_token('accept_request' ~ request.id) }}">
                                            <button class="button is-success">
                                                <span class="icon">{{ ux_icon('material-symbols:check') }}</span>
                                                <span>Accepter</span>
                                            </button>
                                        </form>
                                        <form method="post"
                                              action="{{ path('app_contact_request_decline', {'id': request.id}) }}"
                                              hx-post="{{ path('app_contact_request_decline', {'id': request.id}) }}"
                                              hx-confirm="Refuser la demande de {{ request.sender.displayName }} ?"
                                              hx-target="body">
                                            <input type="hidden" name="_token" value="{{ csrf_token('decline_request' ~ request.id) }}">
                                            <button class="button is-danger is-light">
                                                <span class="icon">{{ ux_icon('material-symbols:close') }}</span>
                                                <span>Refuser</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="2" class="has-text-grey is-italic">Aucune demande reçue.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
