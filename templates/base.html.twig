<!DOCTYPE html>
{% set currentTheme = app.user ? (app.user.uiPreferences.theme ?? 'light') : 'light' %}
<html lang="fr" data-theme="{{ currentTheme }}">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>kdo</text></svg>">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        {% block stylesheets %}
            {{ importmap('app') }}
        {% endblock %}
    </head>
    <body>
        <div id="kdo-progress-bar" aria-hidden="true"></div>

        {% set currentRoute = app.request.attributes.get('_route') %}
        {% if app.user or currentRoute != 'app_home' %}
        <nav class="navbar" role="navigation" aria-label="main navigation">
            <div class="navbar-brand">
                <a class="navbar-item {% if currentRoute == 'app_home' %}is-active{% endif %}" href="{{ path('app_home') }}">
                    <strong>KDO</strong>
                </a>

                {% if app.user %}
                    <div class="navbar-mobile-actions is-hidden-desktop is-flex is-align-items-center ml-auto" style="gap: 0.35rem;">
                        {{ include('theme/_toggle_button.html.twig', {theme: currentTheme}) }}
                        <a href="{{ path('app_notification_index') }}"
                           aria-label="Notifications"
                           class="button is-light is-rounded is-small {% if unread_notification_count > 0 %}has-badge-danger{% endif %}">
                            <span class="icon">
                                {{ ux_icon('material-symbols:notifications') }}
                            </span>
                            {% if unread_notification_count > 0 %}
                                <span class="tag is-danger is-rounded is-small notification-badge">{{ unread_notification_count }}</span>
                            {% endif %}
                        </a>
                    </div>
                {% endif %}

                <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="navbarMain">
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                </a>
            </div>
            <div id="navbarMain" class="navbar-menu">
                <div class="navbar-start">
                    {% if app.user %}
                        <a class="navbar-item {% if currentRoute starts with 'app_wish_' %}is-active{% endif %}" href="{{ path('app_wish_index') }}">
                            <span class="icon">{{ ux_icon('material-symbols:list') }}</span>
                            <span>Ma Liste</span>
                        </a>
                        <a class="navbar-item {% if currentRoute starts with 'app_contact_' %}is-active{% endif %}" href="{{ path('app_contact_index') }}">
                            <span class="icon">{{ ux_icon('material-symbols:contacts') }}</span>
                            <span>Contacts</span>
                        </a>
                        <a class="navbar-item {% if currentRoute starts with 'app_project_' %}is-active{% endif %}" href="{{ path('app_project_index') }}">
                            <span class="icon">{{ ux_icon('material-symbols:redeem') }}</span>
                            <span>Projets Cadeaux</span>
                        </a>
                        <a class="navbar-item {% if currentRoute starts with 'app_financial_' %}is-active{% endif %}" href="{{ path('app_financial_index') }}">
                            <span class="icon">{{ ux_icon('material-symbols:euro') }}</span>
                            <span>Finances</span>
                        </a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a class="navbar-item {% if currentRoute starts with 'app_admin_' %}is-active{% endif %}" href="{{ path('app_admin_users') }}">
                                <span class="icon">{{ ux_icon('material-symbols:crown') }}</span>
                                <span>Administration</span>
                            </a>
                        {% endif %}
                    {% endif %}
                </div>
                <div class="navbar-end">
                    {% if app.user %}
                        <div class="navbar-item is-hidden-touch">
                            {{ include('theme/_toggle_button.html.twig', {theme: currentTheme}) }}
                        </div>
                        <div class="navbar-item is-hidden-touch">
                            <a href="{{ path('app_notification_index') }}"
                               data-tour="navbar-notifications"
                               aria-label="Notifications"
                               class="button is-light is-rounded {% if unread_notification_count > 0 %}has-badge-danger{% endif %}">
                                <span class="icon">
                                    {{ ux_icon('material-symbols:notifications') }}
                                </span>
                                {% if unread_notification_count > 0 %}
                                    <span class="tag is-danger is-rounded is-small notification-badge">{{ unread_notification_count }}</span>
                                {% endif %}
                            </a>
                        </div>
                    {% endif %}
                    {% if is_granted('IS_IMPERSONATOR') %}
                        <a class="navbar-item has-text-danger" href="{{ path('app_home', {'_switch_user': '_exit'}) }}">
                            <span class="icon">{{ ux_icon('material-symbols:cancel') }}</span>
                            <span>Quitter l'impersonnation</span>
                        </a>
                    {% endif %}
                    {% if app.user %}
                        <div class="navbar-item has-dropdown is-hoverable">
                            <a class="navbar-link is-flex is-align-items-center" style="gap: 0.5rem;">
                                {{ include('_components/_avatar.html.twig', {name: app.user.displayName, size: 'sm'}) }}
                                <span>{{ app.user.displayName }}</span>
                            </a>

                            <div class="navbar-dropdown is-right">
                                <a class="navbar-item" href="{{ path('app_profile') }}">
                                    <span class="icon">{{ ux_icon('material-symbols:person') }}</span>
                                    <span>Mon Profil</span>
                                </a>
                                <a class="navbar-item"
                                   role="button"
                                   data-tour-start>
                                    <span class="icon">{{ ux_icon('material-symbols:help') }}</span>
                                    <span>Visite guidée</span>
                                </a>
                                <hr class="navbar-divider">
                                <a class="navbar-item" href="{{ path('app_logout') }}">
                                    <span class="icon">{{ ux_icon('material-symbols:logout') }}</span>
                                    <span>Déconnexion</span>
                                </a>
                            </div>
                        </div>
                    {% else %}
                        <a class="navbar-item" href="{{ path('app_login') }}">
                            <span class="icon">{{ ux_icon('material-symbols:login') }}</span>
                            <span>Connexion</span>
                        </a>
                    {% endif %}
                </div>
            </div>
        </nav>
        {% endif %}

        <div class="kdo-toast-stack" aria-live="polite">
            {% for type in ['success', 'warning', 'danger', 'info'] %}
                {% for message in app.flashes(type) %}
                    <div class="notification is-{{ type }} kdo-toast" data-auto-dismiss="4500">
                        <button class="delete" aria-label="delete"></button>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        {% block body %}{% endblock %}

        {# Dynamic HTMX Modal for forms (e.g., Wish New/Edit) #}
        <div id="kdo-dynamic-modal" class="modal" role="dialog" aria-modal="true">
            <div class="modal-background" data-modal-close></div>
            <div class="modal-card" style="max-width: 560px; width: 92%;">
                <section id="kdo-dynamic-modal-body" class="modal-card-body box m-0 p-5"></section>
            </div>
        </div>

        {# Styled HTMX Confirmation Modal #}
        <div id="kdo-confirm-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="kdo-confirm-title">
            <div class="modal-background" data-confirm-cancel></div>
            <div class="modal-card" style="max-width: 420px; width: 92%;">
                <section class="modal-card-body box m-0 p-5">
                    <div class="is-flex is-align-items-flex-start" style="gap: 1rem;">
                        <span class="kpi-icon is-warning is-flex-shrink-0">
                            {{ ux_icon('material-symbols:help', {height: '1.5rem', width: '1.5rem'}) }}
                        </span>
                        <div>
                            <p id="kdo-confirm-title" class="title is-5 mb-2">Confirmation</p>
                            <p id="kdo-confirm-message" class="has-text-grey is-size-6 mb-4"></p>
                        </div>
                    </div>
                    <div class="buttons is-right mt-2 mb-0">
                        <button type="button" class="button is-light" data-confirm-cancel>Annuler</button>
                        <button type="button" class="button is-primary" id="kdo-confirm-ok">Confirmer</button>
                    </div>
                </section>
            </div>
        </div>

        {# Guided Tour Modal Container #}
        <div id="kdo-tour-modal-container"></div>

        {% if app.user %}
            <script type="application/json" id="kdo-tour-config">
                {{ {
                    completeUrl: path('app_tour_complete'),
                    routes: {
                        home: path('app_home'),
                        wish: path('app_wish_index'),
                        contact: path('app_contact_index'),
                        project: path('app_project_index'),
                        financial: path('app_financial_index')
                    }
                }|json_encode|raw }}
            </script>
        {% endif %}
    </body>
</html>
