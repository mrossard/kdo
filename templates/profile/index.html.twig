{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<section class="section">
    <div class="container">
        <div class="columns is-centered">
            <div class="column is-6-tablet is-5-desktop">
                <div class="box has-text-centered mb-5 p-5">
                    <div class="mb-3">
                        {{ include('_components/_avatar.html.twig', {name: app.user.displayName, size: 'lg'}) }}
                    </div>
                    <h1 class="title is-4 mb-1">{{ app.user.displayName }}</h1>
                    <span class="tag is-light is-rounded">{{ app.user.email }}</span>
                </div>

                {# Informations Personnelles #}
                <div class="box mb-5 p-5">
                    <h2 class="title is-5 mb-4">Informations personnelles</h2>
                    {{ form_start(form) }}
                        <div class="columns is-variable is-2 mb-0">
                            <div class="column">
                                <div class="field">
                                    {{ form_label(form.firstname, null, {'label_attr': {'class': 'label'}}) }}
                                    <div class="control">
                                        {{ form_widget(form.firstname) }}
                                    </div>
                                    {{ form_errors(form.firstname) }}
                                </div>
                            </div>
                            <div class="column">
                                <div class="field">
                                    {{ form_label(form.lastname, null, {'label_attr': {'class': 'label'}}) }}
                                    <div class="control">
                                        {{ form_widget(form.lastname) }}
                                    </div>
                                    {{ form_errors(form.lastname) }}
                                </div>
                            </div>
                        </div>

                        <div class="field mt-4">
                            <div class="control">
                                <button type="submit" class="button is-primary is-fullwidth">
                                    <span class="icon">{{ ux_icon('material-symbols:save') }}</span>
                                    <span>Mettre à jour mes infos</span>
                                </button>
                            </div>
                        </div>
                    {{ form_end(form) }}
                </div>

                {# Changement de mot de passe #}
                <div class="box p-5">
                    <h2 class="title is-5 mb-4">Sécurité & Mot de passe</h2>
                    {{ form_start(password_form) }}
                        <div class="field">
                            {{ form_label(password_form.currentPassword, null, {'label_attr': {'class': 'label'}}) }}
                            <div class="control">
                                {{ form_widget(password_form.currentPassword) }}
                            </div>
                            {{ form_errors(password_form.currentPassword) }}
                        </div>

                        <div class="field">
                            {{ form_label(password_form.plainPassword.first, null, {'label_attr': {'class': 'label'}}) }}
                            <div class="control">
                                {{ form_widget(password_form.plainPassword.first) }}
                            </div>
                            {{ form_errors(password_form.plainPassword.first) }}
                        </div>

                        <div class="field">
                            {{ form_label(password_form.plainPassword.second, null, {'label_attr': {'class': 'label'}}) }}
                            <div class="control">
                                {{ form_widget(password_form.plainPassword.second) }}
                            </div>
                            {{ form_errors(password_form.plainPassword.second) }}
                        </div>

                        <div class="field mt-4">
                            <div class="control">
                                <button type="submit" class="button is-warning is-light is-fullwidth">
                                    <span class="icon">{{ ux_icon('material-symbols:key') }}</span>
                                    <span>Changer le mot de passe</span>
                                </button>
                            </div>
                        </div>
                    {{ form_end(password_form) }}
                </div>

                {# Visite guidée & Aide #}
                <div class="box mt-5 p-5">
                    <h2 class="title is-5 mb-3 is-flex is-align-items-center" style="gap: 0.5rem;">
                        <span class="icon has-text-primary">{{ ux_icon('material-symbols:help') }}</span>
                        <span>Visite guidée & Découverte</span>
                    </h2>
                    <p class="is-size-7 has-text-grey mb-4">
                        Revisitez le fonctionnement complet de l'application ou consultez le guide de référence à tout moment.
                    </p>

                    <div class="buttons mb-3">
                        <button type="button"
                                class="button is-primary is-light is-fullwidth"
                                hx-get="{{ path('app_tour_modal', {'step': 1}) }}"
                                hx-target="#kdo-tour-modal-container"
                                hx-swap="innerHTML">
                            <span class="icon">{{ ux_icon('material-symbols:redeem') }}</span>
                            <span>Relancer la visite guidée</span>
                        </button>
                    </div>

                    <div class="level is-mobile mb-0 pt-2" style="border-top: 1px solid var(--bulma-border-weak);">
                        <div class="level-left">
                            <a href="{{ path('app_tour_guide') }}" class="button is-ghost is-small p-0 has-text-link">
                                <span class="icon is-small">{{ ux_icon('material-symbols:open-in-new') }}</span>
                                <span>Consulter le guide complet</span>
                            </a>
                        </div>
                        <div class="level-right">
                            <form method="post" action="{{ path('app_tour_reset') }}">
                                <button type="submit" class="button is-ghost is-small p-0 has-text-grey">
                                    <span>Réafficher à l'accueil</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
