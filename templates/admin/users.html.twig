{% extends 'base.html.twig' %}

{% block title %}Administration - Utilisateurs{% endblock %}

{% block body %}
    <section class="section">
        <div class="container">
            <div class="level mb-5">
                <div class="level-left">
                    <div>
                        <h1 class="title is-3 mb-1">Administration des utilisateurs</h1>
                        <p class="subtitle is-6 mb-0">{{ users|length }} compte{{ users|length > 1 ? 's' : '' }} enregistré{{ users|length > 1 ? 's' : '' }}</p>
                    </div>
                </div>
            </div>

            <div class="table-container">
                <table class="table is-fullwidth">
                    <thead>
                        <tr>
                            <th>Utilisateur</th>
                            <th>Email</th>
                            <th>Rôles</th>
                            {% if app.environment == 'dev' %}
                                <th class="has-text-right">Actions</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td>
                                    <div class="is-flex is-align-items-center" style="gap: 0.65rem;">
                                        {{ include('_components/_avatar.html.twig', {name: user.displayName, size: 'sm'}) }}
                                        <div>
                                            <p class="has-text-weight-semibold">{{ user.displayName }}</p>
                                            <p class="is-size-7 has-text-grey tabular-nums">#{{ user.id }}</p>
                                        </div>
                                    </div>
                                </td>
                                <td>{{ user.email }}</td>
                                <td>
                                    {% for role in user.roles %}
                                        <span class="tag {{ role == 'ROLE_ADMIN' ? 'is-primary is-light' : 'is-light' }}">{{ role }}</span>
                                    {% endfor %}
                                </td>
                                {% if app.environment == 'dev' %}
                                    <td class="has-text-right">
                                        <a href="{{ path('app_home', {'_switch_user': user.email}) }}" class="button is-small is-warning is-light">
                                            <span class="icon is-small">{{ ux_icon('material-symbols:switch-account') }}</span>
                                            <span>Impersonner</span>
                                        </a>
                                    </td>
                                {% endif %}
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="has-text-centered">Aucun utilisateur trouvé.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
{% endblock %}
